# Public example only. Leave secrets empty in Git.
RUNNER_MCP_BEARER_TOKEN=
RUNNER_MCP_AUTH_ISSUER=https://auth.example.invalid/
RUNNER_MCP_RESOURCE_URL=https://mcp.example.invalid/mcp
RUNNER_MCP_PROJECTS_CONFIG=config/projects.example.yml
RUNNER_MCP_AUDIT_LOG=var/audit.jsonl
RUNNER_MCP_RATE_LIMIT_PER_MINUTE=60

# Operator safety / retention
RUNNER_MCP_OPERATOR_STOP_FILE=
RUNNER_MCP_RETENTION_CONFIRMED=false
RUNNER_MCP_MIN_RELEASES_TO_KEEP=20
RUNNER_MCP_MIN_RELEASE_DAYS=90
RUNNER_MCP_PITR_RETENTION_DAYS=30
RUNNER_MCP_PRE_MIGRATION_BACKUP_DAYS=180

# Controlled test jobs
RUNNER_MCP_TEST_JOBS_ROOT=
RUNNER_MCP_MAX_TEST_JOBS=2

# PostgreSQL backups / private DB secrets
RUNNER_MCP_DATABASE_BACKUP_ROOT=
# RUNNER_MCP_DB_EXAMPLE=

# Asynchronous staging deployment jobs
RUNNER_MCP_DEPLOY_JOBS_ROOT=

# Private short-lived human approvals for high-risk staging actions
RUNNER_MCP_APPROVAL_ROOT=
RUNNER_MCP_APPROVAL_TTL_SECONDS=600
