# SOURCE ONLY (#520). Bind @SERVICE_PRIMARY_GROUP@ to the verified
# primary group of the original MCP owner after separate human approval.
# The socket inode MUST remain root-owned; do not install as-is.
[Unit]
Description=One fixed Incus qualification ACL revoke request

[Socket]
ListenStream=/run/runner-mcp-incus-acl-revoke.sock
SocketUser=root
SocketGroup=@SERVICE_PRIMARY_GROUP@
SocketMode=0660
DirectoryMode=0755
Accept=yes
RemoveOnStop=yes
MaxConnections=1

[Install]
WantedBy=sockets.target
