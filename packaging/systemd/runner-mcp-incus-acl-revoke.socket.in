# SOURCE ONLY (#520). Render @SERVICE_ACCOUNT@ from canonical host identity
# only after a separate human approval. Do not install as-is.
[Unit]
Description=One fixed Incus qualification ACL revoke request

[Socket]
ListenStream=/run/runner-mcp-incus-acl-revoke.sock
SocketUser=@SERVICE_ACCOUNT@
SocketGroup=@SERVICE_ACCOUNT@
SocketMode=0600
DirectoryMode=0755
Accept=yes
RemoveOnStop=yes
MaxConnections=1

[Install]
WantedBy=sockets.target
