{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.blacksp1d3r/runner-mcp",
  "title": "Runner MCP",
  "description": "Self-hosted MCP for controlled AI development and staging without a general-purpose remote shell.",
  "version": "0.1.1",
  "websiteUrl": "https://github.com/Blacksp1d3r/runner-mcp",
  "repository": {
    "url": "https://github.com/Blacksp1d3r/runner-mcp",
    "source": "github",
    "id": "1377580607"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "runner-mcp",
      "version": "0.1.1",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:8000/mcp",
        "headers": [
          {
            "name": "Authorization",
            "description": "Bearer token from the private Runner MCP setup. Keep this token in client secret storage.",
            "isRequired": true,
            "isSecret": true,
            "value": "Bearer {token}",
            "variables": {
              "token": {
                "description": "Runner MCP bearer token generated by local setup.",
                "isRequired": true,
                "isSecret": true
              }
            }
          }
        ]
      }
    }
  ]
}
